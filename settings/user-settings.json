{
  "model": "opus",
  "advisorModel": "fable",
  "permissions": {
    "allow": [
      "Bash(flutter build apk *)",
      "Bash(flutter build appbundle *)",
      "Bash(flutter build ipa *)",
      "Bash(bundle exec fastlane ios release_testflight *)",
      "Bash(bundle exec fastlane ios build_adhoc *)",
      "Bash(bundle exec fastlane ios build_appstore *)",
      "Bash(bundle exec fastlane release_testflight)",
      "Bash(bundle exec fastlane release_testflight *)",
      "Bash(bundle exec fastlane build_adhoc)",
      "Bash(bundle exec fastlane build_adhoc *)",
      "Bash(bundle exec fastlane build_appstore)",
      "Bash(bundle exec fastlane build_appstore *)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash drop *)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(git push *)",
      "Bash(git checkout .)",
      "Bash(git checkout -f*)",
      "Bash(git stash clear*)",
      "Bash(sudo *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(!**/.env.sample)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(**/*.pem)",
      "Read(//**/*.keystore)",
      "Read(//**/*.jks)",
      "Read(//**/AuthKey_*.p8)",
      "Read(//**/ApiKey_*.p8)",
      "Read(**/service-account*.json)",
      "Read(**/*-service-account.json)",
      "Read(**/*firebase-adminsdk*.json)",
      "Read(**/secrets.json)",
      "Read(**/credentials.json)",
      "Read(**/key.properties)",
      "Read(**/Unity_lic.ulf)",
      "Read(~/.ssh/*_rsa)",
      "Read(~/.ssh/*_dsa)",
      "Read(~/.ssh/*_ecdsa)",
      "Read(~/.ssh/*_ed25519)",
      "Read(~/.ssh/*_ecdsa_sk)",
      "Read(~/.ssh/*_ed25519_sk)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/sso/cache/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/application_default_credentials.json)",
      "Read(~/.config/gcloud/credentials.db)",
      "Read(~/.config/gcloud/access_tokens.db)",
      "Read(~/.config/gcloud/legacy_credentials/**)",
      "Read(~/.config/configstore/**)",
      "Read(~/.supabase/**)",
      "Read(~/.kube/config)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.yarnrc.yml)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.pub-cache/credentials.json)",
      "Read(~/.config/dart/pub-credentials.json)",
      "Read(~/Library/Application Support/dart/pub-credentials.json)",
      "Read(~/.gradle/gradle.properties)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.fastlane/**)",
      "Read(~/.fastlane-nextc/config/**)",
      "Read(~/.fastlane-nextc/private-keys/**)",
      "Read(~/Library/Application Support/Unity/Unity_lic.ulf)",
      "Bash(git push --force*)",
      "Bash(git push -f)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Release builds and TestFlight uploads are pre-authorized by the user. (1) TestFlight: running the project's iOS fastlane lanes `release_testflight`, `build_adhoc` or `build_appstore` via `bundle exec fastlane` is allowed in any session, from the main session or from a builder subagent/teammate — with or without the `ios` platform word, after a `cd` into the project's ios/ folder, with an `FL_CHANGELOG=...` or `FL_CHANGELOG=\"$(cat <notes file>)\"` prefix, and with output redirected to a log file. This includes `release_testflight`'s `distribute_external` step, which submits the build for Beta App Review and sends it to the project's external TestFlight tester groups: that is beta distribution, not a production App Store release, which the user always does by hand. (2) Release builds: when the user invoked /flutter-build or /unity-build or otherwise asked for a build in this session, building release artifacts locally (`flutter build apk|appbundle|ipa`, renaming them under the project's build/ folder) is allowed."
    ]
  }
}
